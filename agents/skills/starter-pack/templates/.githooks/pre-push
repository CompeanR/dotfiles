#!/bin/sh
zero=0000000000000000000000000000000000000000
pushes_commits=0
while read local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "refs/heads/{{DEFAULT_BRANCH}}" ]; then
        echo "Push to {{DEFAULT_BRANCH}} blocked: push a branch and open a PR instead (bypass: git push --no-verify)." >&2
        exit 1
    fi
    [ "$local_sha" != "$zero" ] && pushes_commits=1
done
[ "$pushes_commits" = 1 ] || exit 0
make check
