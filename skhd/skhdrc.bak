# skhd configuration migrated from AeroSpace

# Focus windows (cmd + hjkl) - Hyprland-like with display fallback
cmd - h [
    "google chrome"   ~
    *                 : yabai -m window --focus west || yabai -m display --focus prev
]
alt - h : yabai -m window --focus west || yabai -m display --focus prev
cmd - j [
    "google chrome"   ~
    *                 : yabai -m window --focus south
]
alt - j : yabai -m window --focus south
cmd - k [
    "google chrome"   ~
    *                 : yabai -m window --focus north
]
alt - k : yabai -m window --focus north
cmd - l [
    "google chrome"   ~
    *                 : yabai -m window --focus east || yabai -m display --focus next
]
alt - l : yabai -m window --focus east || yabai -m display --focus next

# Escape from floating window to last tiled window (alt + ctrl + space)
alt + ctrl - space : yabai -m window --focus recent

# Move windows (cmd + shift + hjkl)
cmd + shift - h : yabai -m window --swap west
cmd + shift - j : yabai -m window --swap south
cmd + shift - k : yabai -m window --swap north
cmd + shift - l : yabai -m window --swap east

# Resize windows (alt + -/=)
alt - 0x1B : yabai -m window --resize left:-50:0; yabai -m window --resize right:-50:0
alt - 0x18 : yabai -m window --resize right:50:0; yabai -m window --resize left:50:0

# Resize with arrow keys (more intuitive - alt + arrow keys)
alt - left : yabai -m window --resize left:-50:0; yabai -m window --resize right:-50:0
alt - right : yabai -m window --resize right:50:0; yabai -m window --resize left:50:0
alt - up : yabai -m window --resize top:0:-50; yabai -m window --resize bottom:0:-50
alt - down : yabai -m window --resize bottom:0:50; yabai -m window --resize top:0:50

# Rotate layout 90/270 degrees (alt + r)
alt - r : yabai -m space --rotate 90

# Flip layout horizontally/vertically (alt + x/y)
alt - x : yabai -m space --mirror x-axis
alt - y : yabai -m space --mirror y-axis

# Toggle split type for focused window (alt + e)
alt - e : yabai -m window --toggle split

# Switch to workspace (cmd + number) - Hyprland-like
cmd - 1 [
    "google chrome"   ~
    *                 : yabai -m space --focus 1
]
cmd - 2 [
    "google chrome"   ~
    *                 : yabai -m space --focus 2
]
cmd - 3 [
    "google chrome"   ~
    *                 : yabai -m space --focus 3
]
cmd - 4 [
    "google chrome"   ~
    *                 : yabai -m space --focus 4
]
cmd - 5 [
    "google chrome"   ~
    *                 : yabai -m space --focus 5
]
cmd - 6 [
    "google chrome"   ~
    *                 : yabai -m space --focus 6
]
cmd - 7 [
    "google chrome"   ~
    *                 : yabai -m space --focus 7
]

# Switch to workspace inside Chrome (cmd+numbers belong to Chrome tabs there).
# Everywhere else alt+numbers pass through untouched so herdr keeps alt+1..9.
alt - 1 [
    "google chrome"   : yabai -m space --focus 1
    *                 ~
]
alt - 2 [
    "google chrome"   : yabai -m space --focus 2
    *                 ~
]
alt - 3 [
    "google chrome"   : yabai -m space --focus 3
    *                 ~
]
alt - 4 [
    "google chrome"   : yabai -m space --focus 4
    *                 ~
]
alt - 5 [
    "google chrome"   : yabai -m space --focus 5
    *                 ~
]
alt - 6 [
    "google chrome"   : yabai -m space --focus 6
    *                 ~
]
alt - 7 [
    "google chrome"   : yabai -m space --focus 7
    *                 ~
]

# Move window to workspace and follow (cmd + shift + number) - Hyprland-like
cmd + shift - 1 : yabai -m window --space 1 --focus
cmd + shift - 2 : yabai -m window --space 2 --focus
cmd + shift - 3 : yabai -m window --space 3 --focus
cmd + shift - 4 : yabai -m window --space 4 --focus
cmd + shift - 5 : yabai -m window --space 5 --focus
cmd + shift - 6 : yabai -m window --space 6 --focus
cmd + shift - 7 : yabai -m window --space 7 --focus

# Fullscreen (alt + shift + f)
alt + shift - f : yabai -m window --toggle zoom-fullscreen

# Layout switching
alt - 0x2C : yabai -m space --layout bsp
alt - 0x2B : yabai -m space --layout stack

# Workspace back and forth (alt + tab)
alt - tab : yabai -m space --focus recent

# Move workspace to monitor (alt + shift + tab)
alt + shift - tab : yabai -m window --display next; yabai -m display --focus next

# Special commands
# Reload config (alt + shift + r)
alt + shift - r : yabai --restart-service; skhd --restart-service

# Balance layout (alt + shift + b)
alt + shift - b : yabai -m space --balance

# Toggle floating (alt + ctrl + f)
alt + ctrl - f : yabai -m window --toggle float

# Launch applications
alt - return : osascript -e 'tell application "Ghostty" to make new window'
alt - b : osascript -e 'tell application "Google Chrome" to make new window'

# Close window (Hyprland style)
alt + shift - q : yabai -m window --close

# Interactive VPS screenshot: drag a region, or press Space and click a window.
ctrl + alt + cmd - 4 : /Users/compean/scripts/vps_screenshot_macos.sh
