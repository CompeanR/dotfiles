{
  "env": {
    "CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS": "2000",
    "CLAUDISH_PROVIDER": "openai",
    "CLAUDISH_MODEL": "gpt-5.6-luna"
  },
  "permissions": {
    "allow": [
      "mcp__plugin_engram_engram__*"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "enabledPlugins": {
    "engram@engram": true,
    "mattpocock-skills@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "claudish-to-english@gvzdv-plugins": true
  },
  "extraKnownMarketplaces": {
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    },
    "gvzdv-plugins": {
      "source": {
        "source": "github",
        "repo": "gvzdv/claudish-to-english"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-4-6": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
