{
  "env": {
    "CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS": "2000",
    "CLAUDISH_PROVIDER": "openai",
    "CLAUDISH_MODEL": "gpt-5.6-luna",
    "MOSHI_LONG_TURN_SECONDS": "1200",
    "MOSHI_NOTIFY_TYPES": "",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/claude/mods/findings"
  },
  "permissions": {
    "allow": ["mcp__plugin_engram_engram__*"],
    "defaultMode": "auto"
  },
  "ultracode": true,
  "model": "opus",
  "enabledPlugins": {
    "engram@engram": true,
    "mattpocock-skills@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    },
    "gvzdv-plugins": {
      "source": {
        "source": "github",
        "repo": "gvzdv/claudish-to-english"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-4-6": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "custom:matte-black",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/moshi-alert.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/moshi-alert.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/moshi-alert.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
