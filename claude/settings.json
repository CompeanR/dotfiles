{
  "env": {
    "CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS": "2000",
    "CLAUDISH_PROVIDER": "openai",
    "CLAUDISH_MODEL": "gpt-5.6-luna"
  },
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "mcp__plugin_engram_engram__*",
      "mcp__pi__*"
    ],
    "deny": [
      "Agent"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|WebFetch|WebSearch|Bash|Edit|Write|NotebookEdit|MultiEdit|TaskOutput|mcp__pi__subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/claude/scripts/pi-routing-gate.py\" pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Glob|Grep|WebFetch|WebSearch|Bash|Edit|Write|NotebookEdit|MultiEdit|AskUserQuestion|mcp__pi__subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/claude/scripts/pi-routing-gate.py\" post",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Read|Glob|Grep|WebFetch|WebSearch|Bash|Edit|Write|NotebookEdit|MultiEdit|mcp__pi__subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/claude/scripts/pi-routing-gate.py\" failure",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/claude/scripts/pi-routing-gate.py\" prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/claude/scripts/pi-routing-gate.py\" stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/compean/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/dotfiles/claude/scripts/pi-routing-gate.py\" cleanup",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "engram@engram": true,
    "mattpocock-skills@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "claudish-to-english@gvzdv-plugins": true
  },
  "extraKnownMarketplaces": {
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    },
    "gvzdv-plugins": {
      "source": {
        "source": "github",
        "repo": "gvzdv/claudish-to-english"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-4-6": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}