# Arch / Omarchy laptop Ghostty config.
# Mirrors the Alacritty UI/UX used on this machine.
config-file = ~/.config/ghostty/config-common

# Theme follows the active Omarchy theme, like Alacritty's general.import does.
config-file = ~/.local/state/omarchy/current/theme/ghostty.conf

font-family = Liga SFMono Nerd Font
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 12.5

window-padding-x = 10
window-padding-y = 10
window-decoration = none
background-opacity = 0.80

term = xterm-256color

# GTK chrome: dark and flat, colored from the Omarchy theme.
# gtk-titlebar is a no-op here (it does nothing when window-decoration = none).
gtk-tabs-location = top
gtk-wide-tabs = false
window-theme = ghostty
gtk-toolbar-style = flat

# Tab bar / popovers restyled from the active Omarchy theme. The file is
# regenerated by ghostty/omarchy-gtk-css, which the theme-set hook runs on
# every `omarchy theme set`. ? = ignore if it hasn't been generated yet.
gtk-custom-css = ?~/.config/ghostty/gtk-omarchy.css

# osc52 = "CopyPaste"
clipboard-read = allow
clipboard-write = allow

# keybindings (matching alacritty.toml)
keybind = shift+insert=paste_from_clipboard
keybind = ctrl+insert=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = shift+enter=text:\x1b\x0d

# Unbind write_screen_file defaults — they conflict with herdr's next/prev agent
keybind = ctrl+shift+j=unbind
keybind = super+ctrl+shift+j=unbind

# Leader/prefix bindings, same layout as macOS but super+s instead of cmd+s
# (ctrl+s is a common shell shortcut, so SUPER+S is unbound in Hyprland instead).
keybind = super+s>r=reload_config
keybind = super+s>x=close_surface
keybind = super+s>n=new_window

# tabs
keybind = super+s>c=new_tab
keybind = super+s>shift+l=next_tab
keybind = super+s>shift+h=previous_tab
keybind = super+s>comma=move_tab:-1
keybind = super+s>period=move_tab:1

# quick tab switch
keybind = super+s>1=goto_tab:1
keybind = super+s>2=goto_tab:2
keybind = super+s>3=goto_tab:3
keybind = super+s>4=goto_tab:4
keybind = super+s>5=goto_tab:5
keybind = super+s>6=goto_tab:6
keybind = super+s>7=goto_tab:7
keybind = super+s>8=goto_tab:8
keybind = super+s>9=goto_tab:9

# split
keybind = super+s>\=new_split:right
keybind = super+s>-=new_split:down
keybind = super+s>j=goto_split:bottom
keybind = super+s>k=goto_split:top
keybind = super+s>h=goto_split:left
keybind = super+s>l=goto_split:right
keybind = super+s>z=toggle_split_zoom
keybind = super+s>e=equalize_splits

# quick terminal (Ghostty can't grab a global hotkey on Wayland, so bind it
# from Hyprland instead: bind = SUPER, escape, exec, ghostty +quick-terminal)
keybind = super+s>t=toggle_quick_terminal

keybind = super+s>o=toggle_tab_overview
