# Per-host dispatcher.
#
# install.sh symlinks ghostty/config-host -> config-macos or config-linux
# depending on `uname -s`. Each of those pulls in config-common.
# If you see an unstyled Ghostty, rerun ./install.sh on this machine.
config-file = ?~/.config/ghostty/config-host

# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u

# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
