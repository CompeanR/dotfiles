#!/bin/bash
# Regenerate Ghostty's GTK stylesheet from the active Omarchy theme.
#
# Ghostty themes the terminal grid from ~/.local/state/omarchy/current/theme/ghostty.conf,
# but the GTK chrome around it (tab bar, header, popovers) is styled by libadwaita
# and ignores that palette. This script bridges the gap: it reads the theme's colors
# and writes a stylesheet that config-linux loads via gtk-custom-css.
#
# Run by ~/.config/omarchy/hooks/theme-set.d/ on every theme switch, and once by
# install.sh so the file exists on a fresh checkout.

set -euo pipefail

THEME_CONF="${OMARCHY_THEME_CONF:-$HOME/.local/state/omarchy/current/theme/ghostty.conf}"
OUT="${GHOSTTY_GTK_CSS:-$HOME/.config/ghostty/gtk-omarchy.css}"

[[ -f $THEME_CONF ]] || { echo "omarchy-gtk-css: no theme at $THEME_CONF" >&2; exit 0; }

# `key = value` / `palette = N=#hex` -> hex, first match wins.
color() {
  local want=$1 fallback=$2 hit
  hit=$(sed -nE "s/^[[:space:]]*${want}[[:space:]]*=[[:space:]]*(#[0-9a-fA-F]{6}).*/\1/p" "$THEME_CONF" | head -1)
  printf '%s' "${hit:-$fallback}"
}
palette() {
  local idx=$1 fallback=$2 hit
  hit=$(sed -nE "s/^[[:space:]]*palette[[:space:]]*=[[:space:]]*${idx}=(#[0-9a-fA-F]{6}).*/\1/p" "$THEME_CONF" | head -1)
  printf '%s' "${hit:-$fallback}"
}

# Match the terminal's own transparency so the chrome doesn't read as a solid slab.
opacity=$(sed -nE 's/^[[:space:]]*background-opacity[[:space:]]*=[[:space:]]*([0-9.]+).*/\1/p' \
  "$HOME/.config/ghostty/config-host" 2>/dev/null | head -1)
opacity=${opacity:-0.80}

bg=$(color background "#121212")
fg=$(color foreground "#bebebe")
sel=$(color selection-background "#515151")
dim=$(palette 8 "#8a8a8d")     # bright black - inactive tab text
accent=$(palette 12 "#f59e0b") # bright blue  - active tab underline

mkdir -p "$(dirname "$OUT")"
cat > "$OUT" <<CSS
/* Generated by ghostty/omarchy-gtk-css from $THEME_CONF - do not edit by hand. */
@define-color ghostty_bg $bg;
@define-color ghostty_fg $fg;
@define-color ghostty_sel $sel;
@define-color ghostty_dim $dim;
@define-color ghostty_accent $accent;

/* Never paint the window itself - a solid layer here would sit on top of
   Ghostty's background-opacity and block the compositor's blur entirely. */
window,
window.background {
  background-color: transparent;
  background-image: none;
}

/* Chrome carries the same alpha as the terminal grid so it blends in. */
headerbar,
.titlebar,
tabbar,
tabbar .box,
tabbar tabbox,
tabbar > revealer > box {
  background-color: alpha(@ghostty_bg, $opacity);
  background-image: none;
  box-shadow: none;
  border-color: @ghostty_sel;
}

headerbar,
.titlebar,
tabbar {
  border: none;
  min-height: 0;
}

/* Flat, square tabs - no Adwaita pill. */
tabbar tab,
tabbar tabbox > tabboxchild > tab {
  background-color: transparent;
  background-image: none;
  color: @ghostty_dim;
  border: none;
  border-radius: 0;
  box-shadow: none;
  outline: none;
  margin: 0;
  padding: 2px 12px;
  min-height: 0;
}

tabbar tab:hover {
  background-color: @ghostty_sel;
  color: @ghostty_fg;
}

tabbar tab:checked,
tabbar tab:selected {
  background-color: transparent;
  color: @ghostty_fg;
  box-shadow: inset 0 -2px @ghostty_accent;
}

tabbar tab button.close,
tabbar tab .close-button {
  color: @ghostty_dim;
  background: transparent;
  box-shadow: none;
}

tabbar tab button.close:hover,
tabbar tab .close-button:hover {
  color: @ghostty_accent;
}

/* Popovers: command palette, context menu.
   Do NOT style taboverview here - AdwTabOverview wraps the whole window
   content in Ghostty's widget tree, so giving it a background paints an opaque
   layer over the entire terminal and kills background-opacity. */
popover > contents,
popover.menu > contents {
  background-color: @ghostty_bg;
  color: @ghostty_fg;
  border: 1px solid @ghostty_sel;
  box-shadow: none;
}
CSS

echo "omarchy-gtk-css: wrote $OUT"
