#!/bin/bash
# Omarchy theme-set hook: regenerate Ghostty's GTK stylesheet, then reload
# every running Ghostty so the tab bar repaints without restarting the terminal.
# Installed as ~/.config/omarchy/hooks/theme-set.d/ghostty-gtk-css by install.sh.

set -euo pipefail

"$HOME/.config/ghostty/omarchy-gtk-css"

# Ghostty reloads its config (and custom CSS) on SIGUSR2.
pkill -USR2 -x ghostty 2>/dev/null || true
