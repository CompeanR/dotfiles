{
    "$schema": "https://opencode.ai/config.json",
    "plugin": ["opencode-gemini-auth", "file:///home/compean/.config/opencode/plugins/notify.ts"],
    "agent": {
        "autoaccept": {
            "mode": "primary",
            "tools": {
                "write": true,
                "edit": true,
                "bash": true
            },
            "permission": {
                "edit": "allow"
            }
        },
    },
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true,
            "timeout": 2500
        },
        // "notion": {
        //     "type": "remote",
        //     "url": "https://mcp.notion.com/mcp",
        //     "enabled": true,
        //     "timeout": 2500
        // },
        // "Framelink_Figma_MCP": {
        //     "type": "local",
        //     "command": [
        //         "npx",
        //         "-y",
        //         "figma-developer-mcp",
        //         "--figma-api-key=${FIGMA_API_KEY}",
        //         "--stdio"
        //     ],
        //     "enabled": true
        // },
        "engram": {
            "command": ["engram", "mcp", "--tools=agent"],
            "enabled": true,
            "type": "local"
        },
        "playwright": {
            "type": "local",
            "command": ["npx", "-y", "@playwright/mcp@latest"],
            "enabled": true
        },
        "stitch": {
            "type": "remote",
            "url": "https://stitch.googleapis.com/mcp",
            "enabled": true,
            "headers": {
                "X-Goog-Api-Key": "${GOOGLE_API_KEY}"
            }
        }
    }
}
