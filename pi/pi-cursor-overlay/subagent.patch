diff --git a/tests/native-subagent-rejection.test.ts b/tests/native-subagent-rejection.test.ts
new file mode 100644
index 0000000..ad4d76d
--- /dev/null
+++ b/tests/native-subagent-rejection.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it } from "vitest";
+import { fromBinary } from "@bufbuild/protobuf";
+import { AgentClientMessageSchema, AgentServerMessageSchema } from "../src/proto/agent_pb.js";
+import { processServerMessage } from "../src/stream/server-messages.js";
+import type { StreamState } from "../src/stream/types.js";
+
+function varint(value: number): number[] {
+  const bytes: number[] = [];
+  let remaining = value >>> 0;
+  while (remaining >= 0x80) {
+    bytes.push((remaining & 0x7f) | 0x80);
+    remaining >>>= 7;
+  }
+  bytes.push(remaining);
+  return bytes;
+}
+
+function field(fieldNumber: number, payload: number[]): number[] {
+  return [...varint((fieldNumber << 3) | 2), ...varint(payload.length), ...payload];
+}
+
+function textField(fieldNumber: number, value: string): number[] {
+  return field(fieldNumber, [...new TextEncoder().encode(value)]);
+}
+
+function capturedSubagentExec(): Uint8Array {
+  const subagentArgs = [
+    ...textField(1, "tool-call-1"),
+    ...textField(2, "generalPurpose"),
+    ...textField(3, "grok-4.6"),
+    ...textField(4, "Reply with a smoke-test status."),
+  ];
+  const execServerMessage = [
+    0x08,
+    0x07,
+    ...textField(15, "exec-1"),
+    ...field(28, subagentArgs),
+    ...field(55, []),
+  ];
+  return new Uint8Array(field(2, execServerMessage));
+}
+
+function connectPayload(frame: Uint8Array): Uint8Array {
+  const size = Buffer.from(frame).readUInt32BE(1);
+  return frame.subarray(5, 5 + size);
+}
+
+describe("Cursor-native subagent exec", () => {
+  it("rejects field 28 so the model can fall back to the Pi MCP subagent tool", () => {
+    const serverMessage = fromBinary(AgentServerMessageSchema, capturedSubagentExec());
+    const sentFrames: Uint8Array[] = [];
+    const state: StreamState = {
+      toolCallIndex: 0,
+      pendingExecs: [],
+      outputTokens: 0,
+      totalTokens: 0,
+      turnEnded: false,
+    };
+
+    const handled = processServerMessage(
+      serverMessage,
+      new Map(),
+      [],
+      (frame) => sentFrames.push(frame),
+      state,
+      () => {},
+      () => {},
+    );
+
+    expect(handled).toBe(true);
+    expect(sentFrames).toHaveLength(1);
+    const response = fromBinary(AgentClientMessageSchema, connectPayload(sentFrames[0]!));
+    expect(response.message.case).toBe("execClientMessage");
+    expect((response.message.value as any).message.case).toBe("subagentResult");
+    expect((response.message.value as any).message.value.result.case).toBe("error");
+  });
+});
